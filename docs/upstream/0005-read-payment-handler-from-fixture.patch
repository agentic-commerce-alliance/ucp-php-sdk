+def get_handler_id(instrument_id: str = "instr_1") -> str:
+  """Return the payment handler the merchant under test declared for an instrument.
+
+  Read from ``payment_instruments.csv`` like ``get_valid_payment_payload`` does. A Business
+  MUST reject an instrument for a handler it does not implement, so a literal here fails every
+  merchant except the reference server -- on a value it was never given a way to configure.
+  """
+  instr_data = next(
+    (pi for pi in test_data.payment_instruments if pi["id"] == instrument_id),
+    None,
+  )
+  return (instr_data or {}).get("handler_id", "mock_payment_handler")
+
