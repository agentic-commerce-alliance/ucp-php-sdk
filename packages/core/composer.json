{
    "name": "ucp-php-sdk/core",
    "description": "Universal Commerce Protocol (UCP) merchant SDK for PHP: discovery, catalog, cart, checkout, orders and request signing",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "Ucp\\Sdk\\": "src/"
        }
    },
    "keywords": [
        "ucp",
        "universal-commerce-protocol",
        "agentic-commerce",
        "ai-agents",
        "ecommerce",
        "checkout",
        "sdk",
        "php"
    ],
    "homepage": "https://www.agentic-commerce.sh/protokolle/ucp/",
    "support": {
        "docs": "https://github.com/agentic-commerce-alliance/ucp-php-sdk/blob/main/docs/getting-started.md",
        "issues": "https://github.com/agentic-commerce-alliance/ucp-php-sdk/issues",
        "source": "https://github.com/agentic-commerce-alliance/ucp-php-sdk"
    }
}
