{
    "name": "ucp-php-sdk/symfony-bundle",
    "description": "Symfony integration for the Universal Commerce Protocol (UCP): merchant HTTP endpoints, configuration and storage adapters",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "doctrine/dbal": "^3.7 || ^4.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/deprecation-contracts": "^3.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0",
        "ucp-php-sdk/core": ">=0.0.7 <0.1.0"
    },
    "autoload": {
        "psr-4": {
            "Ucp\\Sdk\\Symfony\\": "src/"
        }
    },
    "keywords": [
        "ucp",
        "universal-commerce-protocol",
        "agentic-commerce",
        "ai-agents",
        "ecommerce",
        "checkout",
        "sdk",
        "symfony",
        "bundle"
    ],
    "homepage": "https://www.agentic-commerce.sh/protokolle/ucp/",
    "support": {
        "docs": "https://github.com/agentic-commerce-alliance/ucp-php-sdk/blob/main/docs/getting-started.md",
        "issues": "https://github.com/agentic-commerce-alliance/ucp-php-sdk/issues",
        "source": "https://github.com/agentic-commerce-alliance/ucp-php-sdk"
    }
}
