#!/usr/bin/env php
<?php

declare(strict_types=1);

use MerchantSymfonyApp\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;

require dirname(__DIR__, 3) . '/vendor/autoload.php';

// The SDK ships its operational commands -- signing-key rotation, storage cleanup, nonce purging
// -- as console commands, and without an entry point this example had no way to run any of them.
// That is not only inconvenient: a merchant with no signing key cannot sign a webhook, so the
// omission silently disabled outbound order events.
$input = new ArgvInput();
/**
 * `getenv()` too. Under the built-in server an exported variable reaches neither `$_ENV`
 * nor `$_SERVER` -- `variables_order` governs the first and CGI-style population the
 * second -- so reading only those two silently resolved `APP_ENV=prod` to `dev`, which is
 * how the conformance lane came to run with development-mode profile fetching enabled.
 * `Kernel` already reads its own variables this way; this is the one that decides whether
 * those affordances exist at all.
 */
function ucp_merchant_env(string $name): ?string
{
    $value = $_ENV[$name] ?? $_SERVER[$name] ?? getenv($name);

    return is_string($value) && $value !== '' ? $value : null;
}

$environment = (string) ($input->getParameterOption(['--env', '-e'], ucp_merchant_env('APP_ENV') ?? 'dev', true));
$debug = filter_var(
    ucp_merchant_env('APP_DEBUG') ?? ($environment === 'dev'),
    FILTER_VALIDATE_BOOL,
) && ! $input->hasParameterOption('--no-debug', true);

$application = new Application(new Kernel($environment, $debug));
$application->run($input);
