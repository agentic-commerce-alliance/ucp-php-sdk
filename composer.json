{
    "name": "shopware/ucp-php-sdk",
    "description": "UCP PHP SDK for Symfony and plain PHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "shopware/ucp-php-sdk-core": "^0.0.1@alpha",
        "ucp-php-sdk/symfony-bundle": "^0.0.1@alpha"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.80",
        "icanhazstring/composer-unused": "^0.9.4",
        "infection/infection": "^0.31.9",
        "pdepend/pdepend": "^2.16",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "roave/backward-compatibility-check": "^8.12",
        "shipmonk/dead-code-detector": "^1.1",
        "symfony/browser-kit": "^6.4 || ^7.0",
        "symfony/css-selector": "^6.4 || ^7.0",
        "symfony/dotenv": "^6.4 || ^7.0",
        "symfony/phpunit-bridge": "^8.1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "shopware/ucp-php-sdk-core": "0.0.1-alpha1"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/symfony-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "ucp-php-sdk/symfony-bundle": "0.0.1-alpha1"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "BootstrapSymfonyApp\\": "examples/bootstrap-symfony-app/src/",
            "MerchantSymfonyApp\\": "examples/merchant-symfony-app/src/",
            "Ucp\\Sdk\\Tests\\": "packages/core/tests/",
            "Ucp\\Sdk\\Symfony\\Tests\\": "packages/symfony-bundle/tests/"
        },
        "files": [
            "tools/InternalClassReferenceScanner.php"
        ]
    },
    "scripts": {
        "cs:check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "dead-code:phpstan": "vendor/bin/phpstan analyse --configuration=phpstan-dead-code.neon.dist --memory-limit=1G",
        "reports:prepare": "@php -r \"foreach (['var/reports/pdepend', 'var/reports/coverage', 'var/reports/coverage/html', 'var/reports/dead-code', 'var/reports/infection', 'var/reports/infection-full'] as \\$dir) { is_dir(\\$dir) || mkdir(\\$dir, 0777, true); }\"",
        "metrics:prepare": "@reports:prepare",
        "metrics:pdepend": [
            "@metrics:prepare",
            "vendor/bin/pdepend --summary-xml=var/reports/pdepend/summary.xml --jdepend-xml=var/reports/pdepend/jdepend.xml --jdepend-chart=var/reports/pdepend/dependencies.svg --overview-pyramid=var/reports/pdepend/overview-pyramid.svg packages/core/src,packages/symfony-bundle/src,examples/bootstrap-symfony-app/src,examples/merchant-symfony-app/src"
        ],
        "coverage": [
            "@reports:prepare",
            "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover var/reports/coverage/clover.xml --coverage-html var/reports/coverage/html"
        ],
        "coverage:internal": [
            "@coverage",
            "@php tools/report-internal-coverage.php var/reports/coverage/clover.xml"
        ],
        "coverage:gate": [
            "@coverage",
            "@php tools/report-internal-coverage.php var/reports/coverage/clover.xml var/reports/coverage/internal-summary.json --enforce"
        ],
        "dead-code:internal-refs": "@php tools/check-internal-class-references.php --allowlist=tools/internal-class-allowlist.php --report=var/reports/dead-code/internal-class-references.json",
        "dead-code": [
            "@dead-code:phpstan",
            "@dead-code:internal-refs"
        ],
        "unused-deps": "vendor/bin/composer-unused --configuration=composer-unused.php",
        "mutation": [
            "@reports:prepare",
            "Composer\\Config::disableProcessTimeout",
            "sh scripts/run-infection.sh --configuration=infection.json.dist"
        ],
        "mutation:changed": [
            "@reports:prepare",
            "Composer\\Config::disableProcessTimeout",
            "sh scripts/run-mutation-changed.sh"
        ],
        "mutation:full": [
            "@reports:prepare",
            "Composer\\Config::disableProcessTimeout",
            "sh scripts/run-infection.sh --configuration=infection.full.json.dist"
        ],
        "mutation:gate": [
            "@mutation"
        ],
        "test": [
            "@test:core",
            "@test:symfony"
        ],
        "test:core": "vendor/bin/phpunit --testsuite core",
        "test:symfony": "vendor/bin/phpunit --testsuite symfony",
        "test:storage-platforms": "vendor/bin/phpunit packages/symfony-bundle/tests/Integration/DoctrineDbalSchemaPortabilityTest.php",
        "qa": [
            "@cs:check",
            "@phpstan",
            "@dead-code",
            "@unused-deps",
            "@test",
            "@coverage:gate",
            "@mutation:gate",
            "@public-api:check",
            "@metrics:pdepend"
        ],
        "public-api:dump": "php tools/build-public-api-snapshot.php",
        "public-api:check": "php tools/check-public-api-snapshot.php",
        "bc-check": "vendor/bin/roave-backward-compatibility-check --from=HEAD^ --to=HEAD"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": false
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
